do_limma_binary_local <- function(object,
condition,
treatment_group,
control_group,
covariates = NULL) {
meta_cols <- names(SummarizedExperiment::rowData(object))
if (ProtPipe::has_step(object, "log2_transform")) {
data <- SummarizedExperiment::assay(object) |> as.data.frame()
} else {
object <- ProtPipe::log2_transform(object)
data <- SummarizedExperiment::assay(object) |> as.data.frame()
}
if (anyNA(data)) {
stop("Missing values detected. Please impute before running limma.")
}
DT <- cbind(SummarizedExperiment::rowData(object), data) |> as.data.frame()
meta <- SummarizedExperiment::colData(object) |> as.data.frame()
if (!(condition %in% colnames(meta))) {
stop("`condition` must be a column name in colData(object).")
}
if (treatment_group == control_group) {
stop("Treatment group and control group must be different.")
}
if (!is.null(covariates) && condition %in% covariates) {
stop("Covariates cannot include the grouping variable used for treatment/control.")
}
groups <- meta[[condition]]
treatment_samples <- rownames(meta)[which(!is.na(groups) & groups == treatment_group)]
control_samples <- rownames(meta)[which(!is.na(groups) & groups == control_group)]
if (length(treatment_samples) == 0 || length(control_samples) == 0) {
stop("Treatment or control group has no valid samples after removing missing metadata.")
}
if (length(treatment_samples) < 2 || length(control_samples) < 2) {
stop("Each group must contain at least 2 samples.")
}
missing_samples <- setdiff(c(treatment_samples, control_samples), colnames(DT))
if (length(missing_samples) > 0) {
stop(
paste(
"These samples were found in colData but not in assay data:",
paste(missing_samples, collapse = ", ")
)
)
}
DT_limma <- DT[, c(treatment_samples, control_samples), drop = FALSE]
group_list <- factor(
c(rep("treatment", length(treatment_samples)),
rep("control", length(control_samples))),
levels = c("control", "treatment")
)
design_df <- data.frame(group = group_list)
rownames(design_df) <- c(treatment_samples, control_samples)
if (!is.null(covariates) && length(covariates) > 0) {
for (cov in covariates) {
if (!(cov %in% colnames(meta))) {
stop(paste("Covariate", cov, "not found in colData(object)."))
}
design_df[[cov]] <- meta[rownames(design_df), cov]
}
}
limma_design <- stats::model.matrix(~ 0 + ., data = design_df)
colnames(limma_design) <- make.names(colnames(limma_design))
cont.matrix <- limma::makeContrasts(grouptreatment - groupcontrol, levels = limma_design)
fit <- limma::lmFit(DT_limma, limma_design)
fit2 <- limma::contrasts.fit(fit, cont.matrix)
fit2 <- limma::eBayes(fit2, trend = TRUE)
result_limma <- limma::topTable(fit2, coef = 1, n = Inf)
result_limma <- merge(
DT[, c(meta_cols, treatment_samples, control_samples), drop = FALSE],
result_limma,
by.x = 0,
by.y = 0
)
result_limma$Row.names <- NULL
result_limma[order(result_limma$adj.P.Val, -abs(result_limma$logFC)), ]
}
DE <- do_limma_binary_local(ProtPipe::impute(se, 0), "SEX", "F", "M")
View(DE)
